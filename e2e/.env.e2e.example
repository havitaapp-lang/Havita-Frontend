# Copy to .env.e2e (gitignored) and fill with LOCAL test users only.
# Never point this suite at production: the safety guard in playwright.config.ts
# refuses any base URL that is not localhost / *.localhost / 127.0.0.1.

# Tenant host served by `npm run dev` (Vite proxies /api to the local backend on :9094)
E2E_BASE_URL=http://limonar.localhost:5173

# COMMUNITY_ADMIN of the tenant above (required for admin specs)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# RESIDENT (owner, with at least one active property) of the same tenant (required for Mi Hogar specs)
E2E_RESIDENT_EMAIL=
E2E_RESIDENT_PASSWORD=

# SECURITY user of the same tenant (optional, used by permission specs)
E2E_SECURITY_EMAIL=
E2E_SECURITY_PASSWORD=

# Set to 1 to allow specs that create/edit/delete synthetic E2E- records in the LOCAL database
E2E_ALLOW_WRITES=1
